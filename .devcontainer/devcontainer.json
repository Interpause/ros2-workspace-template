// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/ubuntu
{
	"name": "ROS2 Dev",
	// Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
	// "image": "osrf/ros:humble-desktop-full",
	"build": {
		"dockerfile": "Dockerfile"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	"features": {
		// "ghcr.io/Interpause/mydevfeatures/custom-bash:3: {},
		"ghcr.io/devcontainers/features/docker-outside-of-docker:1": {},
		"ghcr.io/devcontainers/features/git-lfs:1": {},
		"ghcr.io/devcontainers/features/desktop-lite:1": {
			"password": "noPassword",
			"webPort": 6080
		},
		"ghcr.io/devcontainers/features/common-utils:2": {
			"configureZshAsDefaultShell": true,
			"upgradePackages": false,
			"username": "vscode"
		}
	},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	"forwardPorts": [6080],

	// See: https://containers.dev/implementors/json_reference/#lifecycle-scripts
	// Please follow the same method of creating shell scripts in the `hooks` folder.
	"postCreateCommand": ".devcontainer/hooks/postCreate.sh",
	"postStartCommand": ".devcontainer/hooks/postStart.sh",

	// "privileged": true,
	"runArgs": ["--shm-size=32G", "--gpus=all"],
	// "shutdownAction": "none"

	"mounts": [
		{ "type": "volume", "source": "apt-cache", "target": "/var/cache/apt" },
		{ "type": "volume", "source": "apt-list-cache", "target": "/var/lib/apt/lists" },
		{ "type": "volume", "source": "pip-cache", "target": "/home/vscode/.cache/pip" },
		// Access host devices within devcontainer.
		{ "type": "bind", "source": "/dev", "target": "/dev" },
		// Remove below on Linux as they don't exist.
		{ "type": "bind", "source": "/usr/lib/wsl", "target": "/usr/lib/wsl"}
	],

	// Configure tool-specific properties.
	// "customizations": {},

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	"remoteUser": "vscode"
}
